# TMDB v3 API key, or a v4 read access token (those start with "ey").
# Create one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional. Without a key, recaps and answers are direct extracts of the sourced text.
# Any OpenAI-compatible chat completions API works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
